{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

    {# Image : celle uploadée, sinon l'image par défaut de la catégorie #}
    {% if event.image %}
        {% set image = asset('uploads/' ~ event.image) %}
    {% else %}
        {% set image = asset('images/' ~ event.category ~ '.jpg') %}
    {% endif %}

    <article class="cat-{{ event.category }}">
        <header class="detail-hero" style="background-image: url('{{ image }}')">
            <div class="detail-hero-content">
                <span class="badge">{{ event.categoryLabel }}</span>
                <h1>{{ event.title }}</h1>
                <p>{{ event.date|date('d/m/Y · H\\hi') }}</p>
                {% if canEdit %}
                    <a class="btn btn-small" href="{{ path('app_event_edit', {id: event.id}) }}">Modifier</a>
                {% endif %}
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                <p>{{ event.information|nl2br }}</p>
            </section>

            <aside class="card booking">
                {% if event.remainingPlaces > 0 %}
                    <p class="places"><strong>{{ event.remainingPlaces }}</strong> places restantes sur {{ event.places }}</p>
                {% else %}
                    <p class="places"><span class="badge badge-full">Complet</span></p>
                {% endif %}
                <div class="progress"><span style="width: {{ event.participants|length * 100 / event.places }}%"></span></div>

                {% if not app.user %}
                    <a class="btn btn-block" href="{{ path('app_login') }}">Connectez-vous pour vous inscrire</a>
                {% elseif app.user in event.participants %}
                    <p class="muted">Vous êtes inscrit à cet événement.</p>
                    <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}">
                        <button type="submit" class="btn btn-secondary btn-block">Se désinscrire</button>
                    </form>
                {% elseif event.remainingPlaces <= 0 %}
                    <button class="btn btn-block" disabled>Complet</button>
                {% else %}
                    <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                        <button type="submit" class="btn btn-block">S'inscrire</button>
                    </form>
                {% endif %}

                {% if event.participants is not empty %}
                    <h3>Inscrits</h3>
                    <ul>
                        {% for participant in event.participants %}
                            <li>{{ participant.email }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </aside>
        </div>
    </article>
{% endblock %}